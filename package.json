{
  "name": "wakaru",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension: on-device live transcription and ja/en translation for meetings",
  "scripts": {
    "build": "pnpm typecheck && vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json"
  },
  "packageManager": "pnpm@10.34.6",
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
